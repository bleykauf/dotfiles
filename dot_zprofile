# Add ~/.local/bin to PATH (used on Linux, e.g. for oh-my-posh installed via curl)
if [[ -d "$HOME/.local/bin" ]]; then
	export PATH="$HOME/.local/bin:$PATH"
fi

if [[ -f /opt/homebrew/bin/brew ]]; then
	export HOMEBREW_NO_ENV_HINTS=1
	eval "$(/opt/homebrew/bin/brew shellenv)"

	# Ensure keg-only rustup shims win over Homebrew's rust binaries.
	# https://rust-lang.github.io/rustup/installation/already-installed-rust.html
	if [[ -d /opt/homebrew/opt/rustup/bin ]]; then
		export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
	fi
fi