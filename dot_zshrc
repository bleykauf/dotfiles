# Zinit snippets
 zinit snippet OMZ::plugins/git/git.plugin.zsh

# Initialize completion system
autoload -Uz compinit
compinit

# Skip Oh My Posh initialization for Apple Terminal
if [ "$TERM_PROGRAM" != "Apple_Terminal" ] && command -v oh-my-posh &>/dev/null; then
  eval "$(oh-my-posh init zsh --config $HOME/.config/ohmyposh/theme.toml)"
fi

# Load plugins with Zinit
zinit light zdharma-continuum/fast-syntax-highlighting
zinit light zsh-users/zsh-autosuggestions
zinit load 'zsh-users/zsh-history-substring-search'
zinit ice wait atload '_history_substring_search_config'

# Load uv and enable shell completions
if [[ -f "$HOME/.local/bin/env" ]]; then
  . "$HOME/.local/bin/env"
fi
if command -v uv &>/dev/null; then
  eval "$(uv generate-shell-completion zsh)"
fi

# Prefer locally installed fzf over system package
[[ -d "$HOME/.fzf/bin" ]] && path=("$HOME/.fzf/bin" $path)

# Set up fzf key bindings and fuzzy completion (--zsh requires fzf >= 0.48)
if command -v fzf &>/dev/null && fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Initialize zoxide and map it to cd if interactive and zoxide is available
if [[ -o interactive ]] && command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh --cmd cd)"
fi

# Define aliases
if command -v eza &>/dev/null; then
  alias ls="eza --group-directories-first"
fi
if command -v kitten &>/dev/null; then
  alias ssh="kitten ssh"
fi
if command -v ncdu &>/dev/null; then
  alias ncdu="ncdu --color dark"
fi